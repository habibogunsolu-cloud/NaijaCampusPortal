rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /saved_slips/{slipId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Real-time visitor and ad click analytics counters for public portal traffic
    match /analytics/{docId} {
      allow read: if true;
      allow write: if true;
    }
    // Global portal public settings (e.g. ad banners config)
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
